#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
int main() {
    int fd[2];
    pipe(fd);
    if (fork() == 0) {
        close(fd[1]);
        char buf[100];
        read(fd[0], buf, sizeof(buf));
        printf("Child consumed: %s\n", buf);
        close(fd[0]);
        exit(0);
    } else {
        close(fd[0]);
        char msg[] = "Hello from Producer!";
        write(fd[1], msg, sizeof(msg));
        close(fd[1]);
    }

}

